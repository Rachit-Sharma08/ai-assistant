# ============================================================================
# Copy this file to `.env` and fill in the values. Never commit `.env`.
#   cp .env.example .env
# ============================================================================

# --- Groq (LLM provider used by the /api/chat route) ---
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- SerpAPI (web search tool for /api/chat) ---
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- Cartesia (text-to-speech for /api/tts) ---
# https://play.cartesia.ai/keys  |  voices: https://play.cartesia.ai/voices
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
CARTESIA_VERSION=2026-08-14
# "hi" = Hindi/Hinglish (default, best for Roman Hinglish replies)
# "en" = English — set this to test English pronunciation
CARTESIA_LANGUAGE=hi

# Vision model for /api/chat when the conversation contains images
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Speech-to-text model for /api/stt
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- GitHub (repo access / CI automation) ---
# https://github.com/settings/tokens  (scope: repo)
GITHUB_TOKEN=

# --- Vercel (CLI / headless CI deploys) ---
# https://vercel.com/account/tokens
VERCEL_TOKEN=